{
  "name": "temp-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-wasm": "mkdir -p public/ort-wasm && cp node_modules/onnxruntime-web/dist/*.wasm node_modules/onnxruntime-web/dist/*.mjs public/ort-wasm/ 2>/dev/null || true",
    "build": "npm run copy-wasm && tsc -b && vite build",
