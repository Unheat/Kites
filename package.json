{
  "name": "kites",
  "private": true,
  "version": "1.0.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run copy-wasm && tsc -b && vite build",
    "build:dev": "npm run copy-wasm && tsc -b && vite build --mode development",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run src/",
    "test:e2e": "node scripts/test-extension.js",
    "test:webllm": "node scripts/test-webllm-user-flow.js",
    "test:visual:custom-api": "tsx src/test/pipelineVisualTestCustomApi.ts",
    "test:visual:cloudflare": "tsx src/test/pipelineVisualTestCloudflare.ts",
    "test:visual:webllm": "npm run build:dev && tsx src/test/pipelineVisualTestWebLlm.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "clipper-lib": "^6.4.2",
    "dexie": "^4.4.4",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "lucide-react": "^1.24.0",
    "minisearch": "^7.2.0",
    "onnxruntime-web": "^1.27.0",
    "paddleocr": "^1.2.0",
    "paddleocr-js": "^0.4.2",
    "ppu-paddle-ocr": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@webgpu/types": "^0.1.38",
    "autoprefixer": "^10.5.2",
    "canvas": "^3.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.27.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.17",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
