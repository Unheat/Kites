    "clipper-lib": "^6.4.2",
    "dexie": "^4.4.4",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "lucide-react": "^1.24.0",
    "minisearch": "^7.2.0",
    "onnxruntime-web": "^1.27.0",
    "paddleocr": "^1.2.0",
    "paddleocr-js": "^0.4.2",
    "ppu-paddle-ocr": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chrome": "^0.2.2",
