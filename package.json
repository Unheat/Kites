    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "^1.27.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.17",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
