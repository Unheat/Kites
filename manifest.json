{
  "manifest_version": 3,
  "name": "Kites: Spatial Manga Translator",
  "version": "1.0.0",
  "description": "Translate manga and images with spatial awareness.",
  "action": {
    "default_title": "Kites"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ]
}
