/**
 * Cloudflare Worker Configuration
 * For details: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kites-translate-pool",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [
    {
      "pattern": "api.12094852.xyz",
      "custom_domain": true
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "SHARED_POOL",
        "class_name": "SharedPoolDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SharedPoolDO"]
    }
  ],

  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  },

  "preview_urls": true,

  // Staging is a separate Worker and Durable Object namespace. Production version
  // previews can share production bindings; never use them for destructive QA.
  "env": {
    "staging": {
      "name": "kites-translate-pool-staging",
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [
          {
            "name": "SHARED_POOL",
            "class_name": "SharedPoolDO"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
